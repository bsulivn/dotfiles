# ============================================================
# Hyper / Caps Lock
# Karabiner maps Caps Lock -> ctrl + alt + shift + cmd
# ============================================================

# Reset which-key whenever skhd starts or a modal layer exits.
:: default : $HOME/.config/sketchybar/plugins/whichkey-mode.sh default

# ------------------------------------------------------------
# Focus
# ------------------------------------------------------------

ctrl + alt + shift + cmd - h : yabai -m window --focus west
ctrl + alt + shift + cmd - j : yabai -m window --focus south
ctrl + alt + shift + cmd - k : yabai -m window --focus north
ctrl + alt + shift + cmd - l : yabai -m window --focus east


# ------------------------------------------------------------
# Spaces
# ------------------------------------------------------------

ctrl + alt + shift + cmd - 1 : yabai -m space --focus 1
ctrl + alt + shift + cmd - 2 : yabai -m space --focus 2
ctrl + alt + shift + cmd - 3 : yabai -m space --focus 3
ctrl + alt + shift + cmd - 4 : yabai -m space --focus 4
ctrl + alt + shift + cmd - 5 : yabai -m space --focus 5


# ------------------------------------------------------------
# Apps
# ------------------------------------------------------------

ctrl + alt + shift + cmd - return : open -a Ghostty
ctrl + alt + shift + cmd - space  : open -a Raycast
ctrl + alt + shift + cmd - c      : open -a "Visual Studio Code"
ctrl + alt + shift + cmd - s      : open -a Safari


# ------------------------------------------------------------
# Command help
# ------------------------------------------------------------

ctrl + alt + shift + cmd - 0x27 : $HOME/.config/sketchybar/plugins/whichkey.sh toggle


# ------------------------------------------------------------
# Layout
# ------------------------------------------------------------

ctrl + alt + shift + cmd - f : yabai -m window --toggle zoom-fullscreen
ctrl + alt + shift + cmd - b : yabai -m space --balance
ctrl + alt + shift + cmd - t : yabai -m window --toggle float


# ============================================================
# MOVE MODE
#
# Caps + M
# then H/J/K/L
# Escape exits
# ============================================================

:: move : $HOME/.config/sketchybar/plugins/whichkey-mode.sh move

ctrl + alt + shift + cmd - m ; move

move < h : yabai -m window --swap west
move < j : yabai -m window --swap south
move < k : yabai -m window --swap north
move < l : yabai -m window --swap east

move < 1 : yabai -m window --space 1
move < 2 : yabai -m window --space 2
move < 3 : yabai -m window --space 3
move < 4 : yabai -m window --space 4
move < 5 : yabai -m window --space 5

move < escape ; default


# ============================================================
# RESIZE MODE
#
# Caps + R
# then H/J/K/L
# Escape exits
# ============================================================

:: resize : $HOME/.config/sketchybar/plugins/whichkey-mode.sh resize

ctrl + alt + shift + cmd - r ; resize

resize < h : yabai -m window --resize left:-50:0
resize < j : yabai -m window --resize bottom:0:50
resize < k : yabai -m window --resize top:0:-50
resize < l : yabai -m window --resize right:50:0

resize < escape ; default
