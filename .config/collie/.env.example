# Collie (https://colliepwa.dev) — sanitized copy of this machine's config.
# The live file is ~/.config/collie/.env (mode 600) and is NEVER committed: it
# holds the VAPID private key for Web Push. Restore on a new machine:
#
#   1. curl -fsSL https://colliepwa.dev/install.sh | sh
#   2. cp .env.example ~/.config/collie/.env   # this file, from the dotfiles repo
#   3. Set COLLIE_TRUSTED_USER below to your Tailscale login
#   4. collie push-keys mailto:you@example.com  # generates fresh VAPID keys into the .env
#   5. Enable Serve on the tailnet (one-time, browser, as tailnet admin):
#      tailscale serve --bg 8787 prints the login.tailscale.com/f/serve URL
#   6. collie start   # creates the launchd agent + tailscale serve mapping
#   7. collie pair    # QR/code to authorize the phone as the write credential

COLLIE_PORT=8787
COLLIE_HOST=127.0.0.1

# Multiplexer: herdr is the primary supported backend; tmux/zellij are experimental.
COLLIE_MUX=herdr

COLLIE_POLL_MS=1500
COLLIE_READ_LINES=200
COLLIE_SUBMIT_KEYS=Enter

# Tailscale login allowed past the identity gate (tailscale serve injects the
# Tailscale-User-Login header; anything else is rejected).
COLLIE_TRUSTED_USER=you@example.com

# Web Push — do NOT fill in by hand or reuse across machines; `collie push-keys`
# writes all three (step 4 above).
COLLIE_VAPID_PUBLIC=
COLLIE_VAPID_PRIVATE=
COLLIE_VAPID_SUBJECT=mailto:you@example.com
