{
  "name": "Everforest Dark",
  "type": "dark",
  "colors": {
    "editor.background": "#2d353f",
    "editor.foreground": "#d3c6aa",
    "editorLineNumber.foreground": "#7a8478",
    "editorCursor.foreground": "#d3c6aa",
    "editor.selectionBackground": "#3b4248",
    "editor.lineHighlightBackground": "#323c45",
    "editorWhitespace.foreground": "#4f585e"
  },
  "tokenColors": [
    { "scope": ["comment", "punctuation.definition.comment"], "settings": { "foreground": "#7a8478", "fontStyle": "italic" } },
    { "scope": ["string", "string.quoted", "string.unquoted", "constant.other.symbol"], "settings": { "foreground": "#a7c080" } },
    { "scope": ["string.regexp", "string.escape", "constant.other.caps"], "settings": { "foreground": "#83c092" } },
    { "scope": ["constant.numeric", "constant.language", "constant.character"], "settings": { "foreground": "#e69875" } },
    { "scope": ["keyword", "keyword.control", "storage", "storage.type", "keyword.operator"], "settings": { "foreground": "#83c092" } },
    { "scope": ["entity.name.function", "support.function", "meta.function-call"], "settings": { "foreground": "#7fbbb3" } },
    { "scope": ["entity.name.type", "entity.name.class", "entity.name.struct", "support.type", "support.class"], "settings": { "foreground": "#dbbf7a" } },
    { "scope": ["entity.name.namespace", "entity.other.inherited-class"], "settings": { "foreground": "#d699b6" } },
    { "scope": ["variable", "variable.parameter", "meta.definition.variable"], "settings": { "foreground": "#d3c6aa" } },
    { "scope": ["variable.other.constant", "constant.other"], "settings": { "foreground": "#e69875" } },
    { "scope": ["entity.name.tag", "punctuation.definition.tag"], "settings": { "foreground": "#e67e80" } },
    { "scope": ["entity.name.tag.css", "support.type.property-name"], "settings": { "foreground": "#83c092" } },
    { "scope": ["markup.heading"], "settings": { "foreground": "#7fbbb3", "fontStyle": "bold" } },
    { "scope": ["markup.bold"], "settings": { "fontStyle": "bold" } },
    { "scope": ["markup.italic"], "settings": { "fontStyle": "italic" } },
    { "scope": ["markup.inserted"], "settings": { "foreground": "#a7c080" } },
    { "scope": ["markup.deleted"], "settings": { "foreground": "#e67e80" } },
    { "scope": ["invalid"], "settings": { "foreground": "#e67e80" } },
    { "scope": ["punctuation", "meta.brace"], "settings": { "foreground": "#d3c6aa" } }
  ]
}
