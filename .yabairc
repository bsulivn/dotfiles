#!/usr/bin/env sh

# BSP tiling
yabai -m config layout bsp
yabai -m config split_ratio 0.50
yabai -m config auto_balance off
yabai -m config window_placement second_child

# Omarchy-like gaps
yabai -m config top_padding 18
yabai -m config bottom_padding 14
yabai -m config left_padding 14
yabai -m config right_padding 14
yabai -m config window_gap 14

# The MacBook display gets additional safe-area clearance from macOS. Apply
# equivalent clearance explicitly on the external display, and refresh it when
# displays or spaces change.
display_padding_script="$HOME/.config/yabai/update-display-padding.sh"
"$display_padding_script"

for event in display_added display_removed display_moved display_resized space_created; do
  label="display_padding_$event"
  yabai -m signal --remove "$label" >/dev/null 2>&1 || true
  yabai -m signal --add event="$event" label="$label" action="$display_padding_script"
done

# Mouse behavior
yabai -m config mouse_follows_focus off
yabai -m config focus_follows_mouse off

# Window behavior
yabai -m config window_origin_display default

# Focused window borders
borders \
  active_color=0xffe1e3e4 \
  inactive_color=0xff494d64 \
  width=4.0 &
